# i-studio.sk — Websupport (Apache)

RewriteEngine On

# jediná kanonická adresa: https + www (backend vidí HTTPS=on aj za proxy — overené)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.i-studio\.sk$ [NC]
RewriteRule ^ https://www.i-studio.sk%{REQUEST_URI} [R=301,L]

# /kuchyne/ -> /kuchyne (skutočné adresáre ako /admin/ ostávajú)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /kuchyne -> kuchyne.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# vlastná 404 stránka (generuje ju Astro zo src/pages/404.astro)
ErrorDocument 404 /404.html

# staré adresy z pôvodného webu -> nové
Redirect 301 /sitemap.xml /sitemap-index.xml
Redirect 301 /contact.html /kontakt
Redirect 301 /realizacie_galeria_podlahy.html /podlahy
Redirect 301 /realizacie_galeria_dvere.html /dvere
Redirect 301 /realizacie_galeria_skrine.html /skrine
Redirect 301 /realizacie_galeria_kuchyne.html /kuchyne
Redirect 301 /realizacie_galeria_nabytok.html /nabytok
Redirect 301 /realizacie_galeria_obklady.html /obklady
Redirect 301 /arte_galeria.html /dvere
Redirect 301 /atvyn_galeria.html /dvere
Redirect 301 /atvyn_galeria_dekory.html /dvere
Redirect 301 /atvyn_galeria_skla.html /dvere

# HTML sa vždy overí na serveri (inak si prehliadač po nasadení drží starú stránku);
# statické assety majú hash v názve, tie sa môžu kešovať rok
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
