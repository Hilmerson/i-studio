---
/* záverečný čierny pás s výzvou — posledná sekcia stránky (napojí sa priamo na pätičku) */
import { site } from '../data/site';

interface Props {
  title: string;
  emphasis: string;
  text?: string;
  href?: string;
  label?: string;
  /* identifikátor pre anonymné štatistiky (Umami), napr. „cta-domov" */
  event: string;
}
const {
  title,
  emphasis,
  text,
  href = '/kontakt',
  label = 'Nezáväzne konzultovať interiér',
  event,
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}<br /><em>{emphasis}</em></h2>
      {text && <p>{text}</p>}
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={href} data-umami-event={event}>{label}</a>
      <a class="btn btn--light" href={`tel:${site.phoneHref}`} data-umami-event="telefon" data-umami-event-miesto={event}>
        {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--ink);
    color: var(--paper);
    margin-bottom: calc(-1 * var(--space-6));
  }
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }
  .cta-band__copy { max-width: 40rem; }
  .cta-band h2 {
    font-size: var(--step-3);
    color: #fff;
  }
  .cta-band em { font-style: italic; color: var(--yellow); }
  .cta-band p {
    margin-top: var(--space-2);
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    max-width: 52ch;
  }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
