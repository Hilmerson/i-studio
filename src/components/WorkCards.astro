---
/* Karty realizácií. Ak sú publikované projekty, ukáže projekty (odkaz na detail);
   inak ručne vybrané fotky z galérií (odkaz do príslušnej galérie). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photo } from '../lib/photos';
import { categories } from '../data/site';
import type { Projekt } from '../lib/projekty';
import type { VybranaFotka } from '../data/vyber';

interface Props {
  projekty?: Projekt[];
  fotky?: VybranaFotka[];
  limit?: number;
}
const { projekty = [], fotky = [], limit = 4 } = Astro.props;

interface Karta {
  img: ImageMetadata;
  nazov: string;
  meta: string;
  href: string;
}

const karty: Karta[] = projekty.length
  ? projekty.slice(0, limit).map((p) => ({
      img: p.titulna,
      nazov: p.nazov,
      meta: [p.typ, p.lokalita].filter(Boolean).join(' · ') || p.rozsah.map((r) => r.title).join(', '),
      href: p.url,
    }))
  : fotky
      .slice(0, limit)
      .map((f) => ({ f, img: photo(f.image) }))
      .filter((x): x is { f: VybranaFotka; img: ImageMetadata } => Boolean(x.img))
      .map(({ f, img }) => {
        const kat = categories.find((c) => c.slug === f.galeria);
        return { img, nazov: f.popis, meta: `Galéria: ${kat?.title ?? ''}`, href: `/${f.galeria}#galeria` };
      });
---

<ul class="work">
  {
    karty.map((k, i) => (
      <li class="work__item reveal" style={`transition-delay: ${(i % 4) * 110}ms`}>
        <a class="work__link" href={k.href}>
          <span class="work__media media-reveal">
            <Image
              src={k.img}
              widths={[480, 800]}
              sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 25vw"
              format="webp"
              quality={76}
              alt={k.nazov}
              loading="lazy"
            />
          </span>
          <span class="work__label">
            <span class="work__name">{k.nazov}</span>
            <span class="work__meta">{k.meta}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }
  .work__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .work__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
  }
  .work__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }
  .work__link:hover img { transform: scale(1.04); }
  .work__label {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.85rem;
  }
  .work__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.2;
  }
  .work__name::after {
    content: '';
    display: block;
    width: 1.8rem;
    height: 2px;
    margin-top: 0.45rem;
    background: var(--yellow);
    transition: width 300ms var(--ease);
  }
  .work__link:hover .work__name::after { width: 3rem; }
  .work__meta { font-size: 0.88rem; color: var(--muted); }
  @media (max-width: 64rem) {
    .work { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 30rem) {
    .work { grid-template-columns: minmax(0, 1fr); }
    .work__media { aspect-ratio: 4 / 3; }
  }
</style>
