---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  category: string;
  /** limit number of photos shown (e.g. homepage teaser) */
  limit?: number;
  title?: string;
}

const { category, limit, title = 'galéria' } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>(
  '/src/photos/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

// poradie a výber fotiek riadi manifest spravovaný cez Decap CMS (/admin)
const manifests = import.meta.glob<{ photos: { image: string }[] }>('/src/data/galerie/*.json', {
  eager: true,
});

const manifest = manifests[`/src/data/galerie/${category}.json`];

let photos: ImageMetadata[];
if (manifest?.photos?.length) {
  photos = manifest.photos.map((p) => all[p.image]?.default).filter(Boolean);
} else {
  // fallback: bez manifestu zoberie všetko z priečinka
  photos = Object.entries(all)
    .filter(([path]) => path.includes(`/photos/${category}/`))
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(([, mod]) => mod.default);
}

if (limit) photos = photos.slice(0, limit);

// full-size variants for the lightbox
const fullSizes = await Promise.all(
  photos.map((p) => getImage({ src: p, width: 1600, format: 'webp', quality: 80 }))
);
---

{
  photos.length > 0 ? (
    <div class="gallery" data-gallery={category}>
      {photos.map((photo, i) => (
        <a
          class="gallery__item"
          href={fullSizes[i].src}
          data-lightbox-index={i}
          aria-label={`Fotografia ${i + 1} — ${title}`}
        >
          <Image
            src={photo}
            widths={[420, 720]}
            sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
            format="webp"
            quality={78}
            alt=""
            loading="lazy"
          />
        </a>
      ))}
    </div>
  ) : (
    <p class="gallery__empty">Fotografie čoskoro doplníme.</p>
  )
}

<dialog class="lightbox" data-lightbox-dialog>
  <button class="lightbox__close" data-lightbox-close aria-label="Zavrieť">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Predchádzajúca fotografia">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <img class="lightbox__img" alt="" />
  <button class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Ďalšia fotografia">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</dialog>

<style>
  .gallery {
    columns: 3 16rem;
    gap: 0.9rem;
  }
  .gallery__item {
    display: block;
    margin-bottom: 0.9rem;
    break-inside: avoid;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
  }
  .gallery__item img {
    width: 100%;
    transition: transform 400ms var(--ease), opacity 400ms var(--ease);
  }
  .gallery__item:hover img {
    transform: scale(1.03);
  }
  .gallery__empty {
    color: var(--muted);
    border: 1px dashed var(--line);
    padding: var(--space-4);
    text-align: center;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    margin: auto;
    width: fit-content;
    height: fit-content;
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100dvh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(10 10 8 / 0.92);
  }
  .lightbox__img {
    max-width: min(92vw, 70rem);
    max-height: 88dvh;
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    transition: background 180ms var(--ease);
  }
  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: var(--yellow);
    color: var(--ink);
  }
  .lightbox__close { top: 1rem; right: 1rem; }
  .lightbox__nav--prev { left: 1rem; top: 50%; translate: 0 -50%; }
  .lightbox__nav--next { right: 1rem; top: 50%; translate: 0 -50%; }

  @media (max-width: 40rem) {
    .gallery { columns: 2 9rem; gap: 0.6rem; }
    .gallery__item { margin-bottom: 0.6rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling?.matches('[data-lightbox-dialog]')
      ? (gallery.nextElementSibling as HTMLDialogElement)
      : gallery.parentElement?.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    if (!dialog) return;

    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('a[data-lightbox-index]')];
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    let index = 0;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      img.src = links[index].href;
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
