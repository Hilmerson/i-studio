---
import { partnerBrands } from '../data/site';
---

<section class="marquee" aria-label="Značky, s ktorými pracujeme">
  <div class="marquee__viewport">
    <div class="marquee__track">
      <ul class="marquee__list">
        {partnerBrands.map((b) => (
          <li>
            <img
              src={b.logo}
              alt={b.name}
              class:list={['marquee__logo', { 'marquee__logo--invert': b.invert }]}
              height="34"
            />
          </li>
        ))}
      </ul>
      <ul class="marquee__list" aria-hidden="true">
        {partnerBrands.map((b) => (
          <li>
            <img
              src={b.logo}
              alt=""
              class:list={['marquee__logo', { 'marquee__logo--invert': b.invert }]}
              height="34"
            />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: 1.6rem;
  }
  .marquee__viewport {
    overflow: hidden;
    /* jemné vyblednutie na okrajoch */
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }
  .marquee__list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee__list li {
    display: flex;
    align-items: center;
    margin-right: 4.2rem;
  }
  .marquee__logo {
    height: 2.1rem;
    width: auto;
    max-width: 11rem;
    object-fit: contain;
    /* jednotný „prémiový" vzhľad: sivá škála, farba sa objaví pri prejdení myšou */
    filter: grayscale(1);
    opacity: 0.62;
    transition: filter 250ms var(--ease), opacity 250ms var(--ease);
  }
  .marquee__logo:hover {
    filter: none;
    opacity: 1;
  }
  /* biele logá — na svetlom podklade ich treba prevrátiť do tmava */
  .marquee__logo--invert {
    filter: invert(1) grayscale(1);
  }
  .marquee__logo--invert:hover {
    filter: invert(1);
  }
  @keyframes marquee {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
</style>
