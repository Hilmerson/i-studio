---
import { partnerBrands } from '../data/site';

/**
 * Nekonečný pás log. Zoznam je v páse COPIES-krát a animácia posúva presne
 * o šírku jedného zoznamu (100 / COPIES %) — slučka je bezšvová na každej
 * šírke okna až do (COPIES − 1) × šírka zoznamu (~6 200 px pri COPIES = 4).
 */
const COPIES = 4;
---

<section class="marquee" aria-label="Značky, s ktorými pracujeme">
  <div class="marquee__viewport">
    <div class="marquee__track">
      {Array.from({ length: COPIES }, (_, copy) => (
        <ul class="marquee__list" aria-hidden={copy > 0 ? 'true' : undefined}>
          {partnerBrands.map((b) => (
            <li>
              <img
                src={b.logo}
                alt={copy === 0 ? b.name : ''}
                class:list={[
                  'marquee__logo',
                  { 'marquee__logo--invert': b.invert },
                  b.size && `marquee__logo--${b.size}`,
                ]}
                height="34"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style define:vars={{ copies: COPIES }}>
  .marquee {
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: 1.6rem;
  }
  .marquee__viewport {
    overflow: hidden;
    /* jemné vyblednutie na okrajoch */
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 42s linear infinite;
  }
  /* pás sa pri prejdení myšou zastaví — logá sa dajú pohodlne „rozsvietiť" */
  .marquee__viewport:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee__list li {
    display: flex;
    align-items: center;
    margin-right: 4.2rem;
  }
  .marquee__logo {
    height: 2.1rem;
    width: auto;
    max-width: 11rem;
    object-fit: contain;
    /* jednotný „prémiový" vzhľad: sivá škála, farba sa objaví pri prejdení myšou */
    filter: grayscale(1);
    opacity: 0.62;
    transition: filter 250ms var(--ease), opacity 250ms var(--ease);
  }
  .marquee__logo:hover {
    filter: none;
    opacity: 1;
  }
  /* biele logá — na svetlom podklade ich treba prevrátiť do tmava */
  .marquee__logo--invert {
    filter: invert(1) grayscale(1);
  }
  .marquee__logo--invert:hover {
    filter: invert(1);
  }
  /* nízke rozlíšenie — menšie zobrazenie zostáva ostré */
  .marquee__logo--sm {
    height: 1.35rem;
  }
  /* kruhový emblém s drobným textom */
  .marquee__logo--lg {
    height: 2.9rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
