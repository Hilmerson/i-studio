---
import { Image } from 'astro:assets';
import logo from '../assets/i_studio_footer.png';
import { site, categories, yearsOfExperience } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__logo">
        <Image src={logo} alt="i-studio" height={72} densities={[1, 2]} loading="lazy" />
      </p>
      <p class="footer__tag">Vaše interiérové štúdio.<br />Už {yearsOfExperience} rokov zariaďujeme kompletné interiéry pod jednou strechou.</p>
      <div class="footer__social">
        <a href={site.social.facebook} rel="noopener" target="_blank" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.7c0-.9.3-1.6 1.7-1.6h1.5V3.3c-.6-.1-1.5-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3V13h2.7v8h3.5z"/></svg>
        </a>
        <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Sortiment">
      <h2>Sortiment</h2>
      <ul>
        {categories.map((c) => (
          <li><a href={`/${c.slug}`}>{c.title}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-label="Informácie">
      <h2>Informácie</h2>
      <ul>
        <li><a href="/realizacie">Realizácie</a></li>
        <li><a href="/kontakt">Kontakt</a></li>
        <li><a href="/gdpr">Ochrana osobných údajov</a></li>
        <li><a href="/cookies">Cookies</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h2>Kontakt</h2>
      <ul>
        <li>{site.address.street}<br />{site.address.city}</li>
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} i-studio, s.r.o. Všetky práva vyhradené.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: color-mix(in srgb, var(--paper) 78%, transparent);
    margin-top: var(--space-6);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.4fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }
  .footer__logo img {
    height: 2.25rem;
    width: auto;
  }
  .footer__tag {
    margin-top: var(--space-2);
    font-size: 0.95rem;
    max-width: 26ch;
  }
  .footer__social {
    display: flex;
    gap: 0.6rem;
    margin-top: var(--space-3);
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: var(--radius);
    color: var(--paper);
    transition: background 200ms var(--ease), color 200ms var(--ease);
  }
  .footer__social a:hover {
    background: var(--yellow);
    color: var(--ink);
    border-color: var(--yellow);
  }
  .footer__col h2 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: var(--space-2);
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    font-size: 0.95rem;
  }
  .footer__col a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .footer__col a:hover { color: var(--yellow); }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--paper) 12%, transparent);
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }
  @media (max-width: 60rem) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 38rem) {
    .footer__grid { grid-template-columns: 1fr; gap: var(--space-4); }
  }
</style>
