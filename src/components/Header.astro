---
import { Image } from 'astro:assets';
import logo from '../assets/i_studio.png';
import { categories } from '../data/site';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Domov' },
  ...categories.map((c) => ({ href: `/${c.slug}`, label: c.navLabel })),
  { href: '/realizacie', label: 'Realizácie' },
];
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current === `${href}.html`;
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href="/" aria-label="i-studio — domov">
      <Image src={logo} alt="i-studio — vaše interiérové štúdio" height={80} densities={[1, 2]} loading="eager" />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="hlavne-menu">
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav id="hlavne-menu" class="nav" aria-label="Hlavná navigácia">
      <ul class="nav__list">
        {
          links.map((l) => (
            <li>
              <a class="nav__link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__cta" href="/kontakt">Kontakt</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: transform 280ms var(--ease);
  }
  .header.header--hidden {
    transform: translateY(-100%);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
  }
  .brand img {
    height: 2.5rem;
    width: auto;
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    display: inline-block;
    padding: 0.55rem 0.7rem;
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    border-radius: var(--radius);
    transition: color 180ms var(--ease);
    position: relative;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.3rem;
    height: 2px;
    background: var(--yellow);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }
  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav__cta {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background 200ms var(--ease), color 200ms var(--ease);
  }
  .nav__cta:hover {
    background: var(--yellow);
    color: var(--ink);
  }
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.55rem 0.9rem;
  }
  .nav-toggle__bar,
  .nav-toggle__bar::before,
  .nav-toggle__bar::after {
    display: block;
    width: 1.15rem;
    height: 2px;
    background: var(--ink);
    position: relative;
    transition: transform 200ms var(--ease);
  }
  .nav-toggle__bar::before,
  .nav-toggle__bar::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .nav-toggle__bar::before { top: -5px; }
  .nav-toggle__bar::after { top: 5px; }
  .nav-toggle__label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 68rem) {
    .nav-toggle { display: inline-flex; }
    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
    .nav.is-open { display: block; }
    .nav__list {
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-2);
      gap: 0;
    }
    .nav__link {
      display: block;
      padding: 0.85rem 0.75rem;
      font-size: 1.05rem;
    }
    .nav__link::after { display: none; }
    .nav__link[aria-current='page'] {
      background: color-mix(in srgb, var(--yellow) 18%, transparent);
    }
    .nav__cta {
      display: block;
      margin: 0.75rem 0.75rem 0.5rem;
      text-align: center;
      padding: 0.9rem;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.nav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(Boolean(open)));
    });

    // hlavička sa pri scrollovaní nadol schová, pri scrollovaní nahor vráti
    const header = document.querySelector('.header');
    if (!header) return;
    // pri client-side navigácii odstráň listener naviazaný na starú hlavičku
    const prev = (window as any).__headerOnScroll;
    if (prev) window.removeEventListener('scroll', prev);
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const navOpen = nav?.classList.contains('is-open');
      if (!navOpen && y > lastY + 2 && y > 140) {
        header.classList.add('header--hidden');
      } else if (y < lastY - 2 || y <= 140) {
        header.classList.remove('header--hidden');
      }
      lastY = y;
    };
    (window as any).__headerOnScroll = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>
