---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /* drobčeková navigácia pre Google (BreadcrumbList) — bez domovskej stránky, tá sa pridá sama */
  breadcrumbs?: { name: string; path: string }[];
  /* stránky, ktoré nemajú byť v indexe (napr. ďakovacia) */
  noindex?: boolean;
}

const { title, description, breadcrumbs, noindex = false } = Astro.props;
// build.format 'file' dáva pathname s príponou (/kuchyne.html) — kanonická adresa je bez nej
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/^\/index$/, '/');
const canonical = new URL(cleanPath, Astro.site);

const orgId = `${site.url}/#spolocnost`;
const businessId = `${site.url}/#studio`;
const graph: Record<string, unknown>[] = [
  // obchodná spoločnosť — sídlo zapísané v obchodnom registri
  {
    '@type': 'Organization',
    '@id': orgId,
    name: site.legal.name,
    legalName: site.legal.name,
    url: site.url,
    logo: new URL('/favicon.png', site.url).href,
    taxID: site.legal.dic,
    vatID: site.legal.icDph,
    identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: site.legal.ico.replace(/\s/g, '') },
    foundingDate: String(site.foundedYear),
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.legal.seatAddress.street,
      addressLocality: site.legal.seatAddress.locality,
      postalCode: site.legal.seatAddress.postalCode,
      addressCountry: 'SK',
    },
    sameAs: [site.social.facebook, site.social.instagram],
  },
  // štúdio — miesto, kam chodia zákazníci
  {
    '@type': 'LocalBusiness',
    '@id': businessId,
    name: site.name,
    description: 'Kompletné zariadenie interiéru od jedného dodávateľa — kuchyne, skrine a nábytok na mieru, dvere, podlahy a obklady.',
    url: site.url,
    image: new URL('/og.jpg', site.url).href,
    telephone: site.phone,
    email: site.email,
    parentOrganization: { '@id': orgId },
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      postalCode: site.address.postalCode,
      addressCountry: 'SK',
    },
    areaServed: site.serviceArea.map((name) => ({ '@type': 'City', name })),
    openingHoursSpecification: site.openingHoursSpec.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
    sameAs: [site.social.facebook, site.social.instagram],
  },
];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Domov', path: '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.path, site.url).href,
    })),
  });
}
const structuredData = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:site_name" content="i-studio" />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="i-studio — vaše interiérové štúdio, Stupava" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Umami: anonymné štatistiky bez cookies (data-domains: nepočíta dev ani testovacie nasadenia) -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="878d7848-564a-44c4-a953-bac27f3d850a"
      data-domains="www.i-studio.sk,i-studio.sk"
    ></script>
    <script is:inline>
      // pozvánky/reset hesla z Netlify Identity smerujú na koreň webu — presmeruj do administrácie
      if (/(invite_token|recovery_token|confirmation_token)=/.test(location.hash)) {
        location.replace('/admin/' + location.hash);
      }
      // reveal animácie sa zapnú len keď JS naozaj beží; ak sa hlavný modul nenačíta
      // (blokovaný skript, 404 po nasadení), obsah sa po chvíli ukáže aj tak
      document.documentElement.classList.add('js');
      document.addEventListener('astro:page-load', function () { window.__pageLoaded = true; }, { once: true });
      setTimeout(function () {
        if (!window.__pageLoaded) document.documentElement.classList.remove('js');
      }, 3000);
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Preskočiť na obsah</a>
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        background: var(--yellow);
        color: var(--ink);
        padding: 0.75rem 1.25rem;
        font-weight: 600;
        text-decoration: none;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>

    <script>
      // ClientRouter pri client-side navigácii prepíše atribúty <html> tými z novej (statickej) stránky,
      // takže trieda „js" z úvodného inline skriptu zmizne — vrátiť ju ešte pred vykreslením
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
      });

      // reveal-on-scroll: progressive enhancement, no-op with reduced motion
      // (astro:page-load beží pri prvom načítaní aj po každej client-side navigácii)
      document.addEventListener('astro:page-load', () => {
        const items = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && items.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  io.unobserve(e.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          items.forEach((el) => io.observe(el));
        } else {
          items.forEach((el) => el.classList.add('is-visible'));
        }
      });
    </script>
  </body>
</html>
