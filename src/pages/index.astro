---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import heroPhoto from '../photos/hero/slide1.jpg';
import { site, categories, processSteps, yearsOfExperience } from '../data/site';

// bočné fotky kategórií prevzaté z pôvodného webu (470×660)
const tileImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/tiles/*.jpg', {
  eager: true,
});

const tiles = categories.map((c) => ({
  ...c,
  photo: tileImages[`/src/assets/tiles/${c.slug}.jpg`]?.default,
}));
---

<Base
  title="i-studio — Vaše interiérové štúdio | Stupava"
  description={`Kompletné zariadenie interiéru od jedného dodávateľa — podlahy, dvere, skrine, kuchyne, nábytok na mieru a obklady. ${yearsOfExperience} rokov skúseností. Stupava.`}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image
        src={heroPhoto}
        widths={[800, 1400, 1920]}
        sizes="100vw"
        format="webp"
        quality={75}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero__content">
      <p class="hero__kicker">Interiérové štúdio · Stupava</p>
      <h1 class="hero__title">Celý interiér.<br /><em>Jeden dodávateľ.</em></h1>
      <p class="hero__lead">
        Od podláh a dverí až po kuchyne a nábytok na mieru — zameriame, navrhneme, vyrobíme a namontujeme.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/kontakt">Nezáväzný dopyt</a>
        <a class="btn btn--light" href="/realizacie">Pozrieť realizácie</a>
      </div>
    </div>
  </section>

  <!-- VALUE STRIP -->
  <section class="strip" aria-label="Prečo i-studio">
    <div class="container strip__inner">
      <p class="strip__stat"><strong>{yearsOfExperience}</strong> rokov skúseností</p>
      <p class="strip__stat"><strong>1</strong> dodávateľ na celý interiér</p>
      <p class="strip__stat"><strong>100 %</strong> výroba a montáž na mieru</p>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section">
    <div class="container">
      <p class="kicker">O nás</p>
      <div class="about">
        <h2 class="about__title reveal">Profesionáli v zariaďovaní interiéru</h2>
        <div class="prose reveal">
        <p>
          Zaoberáme sa kompletnými službami v oblasti zariaďovania interiéru — od zamerania až po montáž.
          Poradíme vám s výberom a navrhneme riešenie presne podľa vašich potrieb a predstáv.
        </p>
        <p>
          Vašou najväčšou výhodou je <strong>dodanie kompletného interiéru jedným dodávateľom</strong>:
          obklady a sanita, podlahy, dvere so zárubňami, kuchyne, šatníkové skrine aj nábytok na mieru.
          Stačí si len vybrať.
        </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CATEGORY GRID -->
  <section class="section section--tight" aria-labelledby="sortiment-title">
    <div class="container">
      <p class="kicker">Sortiment</p>
      <h2 id="sortiment-title" class="section-title">Čo pre vás zariadime</h2>
      <div class="tiles">
        {
          tiles.map((t, i) => (
            <a class="tile reveal" href={`/${t.slug}`} style={`transition-delay: ${(i % 3) * 60}ms`}>
              {t.photo && (
                <Image
                  src={t.photo}
                  widths={[420, 720]}
                  sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
                  format="webp"
                  quality={75}
                  alt=""
                  loading="lazy"
                />
              )}
              <span class="tile__label">
                <span class="tile__name">{t.title}</span>
                <span class="tile__tag">{t.tagline}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process" aria-labelledby="proces-title">
    <div class="container">
      <p class="kicker">Ako to prebieha</p>
      <h2 id="proces-title" class="section-title">Od návrhu po hotový interiér</h2>
      <ol class="process__list">
        {
          processSteps.map((step, i) => (
            <li class="process__step reveal" style={`transition-delay: ${i * 80}ms`}>
              <span class="process__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <h2>Zariaďujete interiér?<br /><em>Poďme sa porozprávať.</em></h2>
      <div class="cta-band__actions">
        <a class="btn btn--primary" href="/kontakt">Napíšte nám</a>
        <a class="btn btn--light" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero {
    position: relative;
    min-height: min(88dvh, 52rem);
    display: flex;
    align-items: flex-end;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(12 11 8 / 0.88) 0%, rgb(12 11 8 / 0.5) 55%, rgb(12 11 8 / 0.28) 100%);
  }
  .hero__content {
    padding-block: var(--space-6) var(--space-5);
  }
  .hero__kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: var(--space-2);
  }
  .hero__title {
    font-size: var(--step-4);
    font-weight: 600;
    color: #fff;
    max-width: 14ch;
  }
  .hero__title em {
    font-style: italic;
    color: var(--yellow);
  }
  .hero__lead {
    margin-top: var(--space-3);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, #fff 88%, transparent);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  /* strip */
  .strip {
    background: var(--ink);
    color: var(--paper);
  }
  .strip__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .strip__stat {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .strip__stat strong {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--yellow);
    margin-right: 0.5rem;
  }

  /* about */
  .about {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-5);
    align-items: center;
  }
  .about__title {
    font-size: var(--step-3);
    margin: 0;
  }
  .section-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-4);
  }

  /* tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    text-decoration: none;
    color: #fff;
    isolation: isolate;
    background: var(--ink);
  }
  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transition: transform 500ms var(--ease), opacity 500ms var(--ease);
    opacity: 0.92;
  }
  .tile:hover img { transform: scale(1.05); opacity: 1; }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(12 11 8 / 0.85), transparent 55%);
  }
  .tile__label {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tile__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
  }
  .tile__name::after {
    content: '';
    display: block;
    width: 2.2rem;
    height: 3px;
    background: var(--yellow);
    margin-top: 0.5rem;
    transition: width 300ms var(--ease);
  }
  .tile:hover .tile__name::after { width: 3.6rem; }
  .tile__tag {
    font-size: 0.88rem;
    color: color-mix(in srgb, #fff 80%, transparent);
  }

  /* process */
  .process { background: var(--surface); border-block: 1px solid var(--line); }
  .process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }
  .process__num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    color: var(--yellow);
    line-height: 1;
    margin-bottom: var(--space-2);
  }
  .process__step h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .process__step p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* cta band */
  .cta-band {
    background: var(--ink);
    color: var(--paper);
    margin-bottom: calc(-1 * var(--space-6));
  }
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }
  .cta-band h2 {
    font-size: var(--step-3);
    color: #fff;
  }
  .cta-band em { font-style: italic; color: var(--yellow); }
  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 64rem) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .process__list { grid-template-columns: repeat(2, 1fr); }
    .about { grid-template-columns: 1fr; gap: var(--space-3); }
  }
  @media (max-width: 40rem) {
    .tiles { grid-template-columns: 1fr; }
    .process__list { grid-template-columns: 1fr; gap: var(--space-3); }
  }
</style>
