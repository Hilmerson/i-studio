---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import WorkCards from '../components/WorkCards.astro';
import heroPhoto from '../photos/hero/slide1.jpg';
import { site, categories, yearsOfExperience } from '../data/site';
import { vybraneRealizacie, celyPriestor } from '../data/vyber';
import { vybraneProjekty } from '../lib/projekty';
import { photo } from '../lib/photos';

// bočné fotky kategórií prevzaté z pôvodného webu (470×660)
const tileImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/tiles/*.jpg', {
  eager: true,
});

const tiles = categories.map((c) => ({
  ...c,
  photo: tileImages[`/src/assets/tiles/${c.slug}.jpg`]?.default,
}));

const priestor = celyPriestor
  .map((f) => ({ ...f, img: photo(f.image) }))
  .filter((f) => f.img);

// dôvody, prečo si vybrať i-studio — len overiteľné fakty z webu
const dovody = [
  {
    title: `${yearsOfExperience} rokov skúseností`,
    text: `Interiéry zariaďujeme od roku ${site.foundedYear} — v Stupave a okolí.`,
  },
  {
    title: 'Zameranie aj montáž',
    text: 'Priestor zameriame priamo u vás a montáž zabezpečia naši ľudia.',
  },
  {
    title: 'Všetko do seba zapadá',
    text: 'Kuchyňu, skrine, dvere aj podlahy navrhujeme spolu, takže materiály a farby ladia v celom interiéri.',
  },
  {
    title: 'Overení výrobcovia',
    text: 'Pracujeme s materiálmi a kovaním značiek Egger, Kaindl, Blum, Quick-Step a ďalších.',
  },
];
---

<Base
  title="Kompletné zariadenie interiéru na mieru | i-studio Stupava"
  description={`Celý interiér od jedného dodávateľa: kuchyne, skrine a nábytok na mieru, dvere, podlahy a obklady. Zameranie, návrh aj montáž. ${yearsOfExperience} rokov, Stupava.`}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <Image
        src={heroPhoto}
        widths={[800, 1400, 1920]}
        sizes="100vw"
        format="webp"
        quality={75}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container hero__content">
      <p class="hero__kicker">Interiérové štúdio · Stupava</p>
      <h1 class="hero__title">
        <span class="hero__line"><span>Celý interiér.</span></span>
        <span class="hero__line"><span><em>Jeden dodávateľ.</em></span></span>
      </h1>
      <p class="hero__lead">
        Kuchyne, vstavané skrine a nábytok na mieru, dvere, podlahy aj obklady od jedného partnera.
        Zameriame, navrhneme, dodáme a namontujeme — vy máte jeden kontakt a jednu cenovú ponuku.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/kontakt" data-umami-event="cta-hero">Nezáväzne konzultovať interiér</a>
        <a class="btn btn--light" href="/realizacie" data-umami-event="realizacie-hero">Pozrieť realizácie</a>
      </div>
    </div>
  </section>

  <!-- VALUE STRIP -->
  <section class="strip" aria-label="Prečo i-studio">
    <div class="container strip__inner">
      <p class="strip__stat"><strong data-count={yearsOfExperience}>{yearsOfExperience}</strong> rokov skúseností</p>
      <p class="strip__stat"><strong data-count="1">1</strong> dodávateľ na celý interiér</p>
      <p class="strip__stat"><strong data-count={categories.length}>{categories.length}</strong> oblastí interiéru pod jednou strechou</p>
    </div>
  </section>

  <!-- CELÝ PRIESTOR -->
  <section class="section whole" aria-labelledby="cely-priestor-title">
    <div class="container whole__grid">
      <div class="whole__copy">
        <p class="kicker">Kompletné interiéry</p>
        <h2 id="cely-priestor-title" class="whole__title reveal">Zariadime celý priestor. <em>Od podlahy až po posledný detail.</em></h2>
        <div class="prose reveal">
          <p>
            Kuchyňa, vstavané skrine, dvere, podlahy, obklady aj nábytok na mieru — všetko s jedným partnerom.
            Namiesto viacerých firiem a samostatných termínov máte jeden návrh, jednu cenovú ponuku a jeden kontakt,
            ktorý dohliada na to, aby jednotlivé časti do seba zapadli.
          </p>
        </div>
        <ul class="whole__list">
          {categories.map((c) => (
            <li><a href={`/${c.slug}`}>{c.title}</a></li>
          ))}
        </ul>
        <a class="whole__more" href="/kompletne-interiery" data-umami-event="kompletne-domov">
          Ako zariaďujeme celé interiéry
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <div class="whole__photos">
        {priestor.map((f, i) => (
          <a class={`whole__photo whole__photo--${i} reveal`} href={`/${f.galeria}#galeria`} style={`transition-delay: ${i * 120}ms`}>
            <span class="media-reveal">
              <Image
                src={f.img!}
                widths={i === 0 ? [640, 1100] : [360, 640]}
                sizes={i === 0 ? '(max-width: 60rem) 100vw, 40vw' : '(max-width: 60rem) 50vw, 20vw'}
                format="webp"
                quality={76}
                alt={f.popis}
                loading="lazy"
              />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- VYBRANÉ REALIZÁCIE -->
  <section class="section section--tight" aria-labelledby="realizacie-title">
    <div class="container">
      <div class="head-row">
        <div>
          <p class="kicker">Naše práce</p>
          <h2 id="realizacie-title" class="section-title">Vybrané realizácie</h2>
        </div>
        <a class="head-row__link" href="/realizacie">
          Všetky realizácie
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <WorkCards projekty={vybraneProjekty} fotky={vybraneRealizacie} />
    </div>
  </section>

  <!-- PREČO I-STUDIO -->
  <section class="section why" aria-labelledby="preco-title">
    <div class="container">
      <p class="kicker">Prečo i-studio</p>
      <h2 id="preco-title" class="section-title">Na čo sa môžete spoľahnúť</h2>
      <ul class="why__list">
        {dovody.map((d, i) => (
          <li class="why__item reveal" style={`transition-delay: ${i * 90}ms`}>
            <h3>{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CATEGORY GRID -->
  <section class="section section--tight" aria-labelledby="sortiment-title">
    <div class="container">
      <p class="kicker">Sortiment</p>
      <h2 id="sortiment-title" class="section-title">Čo pre vás zariadime</h2>
      <div class="tiles">
        {
          tiles.map((t, i) => (
            <a class="tile reveal" href={`/${t.slug}`} style={`transition-delay: ${(i % 3) * 120}ms`}>
              {t.photo && (
                <span class="tile__media media-reveal">
                  <Image
                    src={t.photo}
                    widths={[420, 720]}
                    sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
                    format="webp"
                    quality={75}
                    alt=""
                    loading="lazy"
                  />
                </span>
              )}
              <span class="tile__label">
                <span class="tile__name">{t.title}</span>
                <span class="tile__tag">{t.tagline}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <ProcessSteps />

  <!-- BRAND MARQUEE -->
  <BrandMarquee />

  <!-- CTA BAND -->
  <CtaBand
    title="Plánujete kuchyňu, celú izbu alebo kompletný interiér?"
    emphasis="Ukážte nám priestor."
    text="Stačí pôdorys alebo pár fotiek z mobilu. Na konzultácii preberieme vaše predstavy, priestor zameriame a pripravíme návrh s cenovou ponukou."
    event="cta-domov"
  />
</Base>

<style>
  /* hero */
  .hero {
    position: relative;
    min-height: min(88dvh, 52rem);
    display: flex;
    align-items: flex-end;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* pomalý Ken Burns zoom hero fotky */
  .hero__media img {
    animation: hero-zoom 18s ease-out forwards;
  }
  @keyframes hero-zoom {
    to { transform: scale(1.07); }
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(12 11 8 / 0.88) 0%, rgb(12 11 8 / 0.5) 55%, rgb(12 11 8 / 0.28) 100%);
  }
  .hero__content {
    padding-block: var(--space-6) var(--space-5);
  }
  .hero__kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 3px rgb(12 11 8 / 0.85), 0 0 18px rgb(12 11 8 / 0.55);
    animation: hero-fade 600ms var(--ease) both;
  }
  .hero__title {
    font-size: var(--step-4);
    font-weight: 600;
    color: #fff;
    max-width: 14ch;
  }
  /* nadpis sa vynára po riadkoch spoza masky */
  .hero__line {
    display: block;
    overflow: hidden;
  }
  .hero__line > span {
    display: block;
    animation: hero-rise 750ms var(--ease) both;
  }
  .hero__line:nth-child(2) > span {
    animation-delay: 140ms;
  }
  .hero__title em {
    font-style: italic;
    color: var(--yellow);
  }
  .hero__lead {
    margin-top: var(--space-3);
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: color-mix(in srgb, #fff 88%, transparent);
    animation: hero-fade 600ms var(--ease) 480ms both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
    animation: hero-fade 600ms var(--ease) 640ms both;
  }
  @keyframes hero-rise {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }
  @keyframes hero-fade {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* strip */
  .strip {
    background: var(--ink);
    color: var(--paper);
  }
  .strip__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .strip__stat {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .strip__stat strong {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--yellow);
    margin-right: 0.5rem;
  }

  .section-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-4);
  }

  /* celý priestor */
  .whole__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: var(--space-5);
    align-items: center;
  }
  .whole__title {
    font-size: var(--step-3);
    margin-bottom: var(--space-3);
  }
  .whole__title em { font-style: italic; color: var(--ink-soft); }
  .whole__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .whole__list a {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--ink-soft);
    transition: background 180ms var(--ease), border-color 180ms var(--ease), color 180ms var(--ease);
  }
  .whole__list a:hover { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
  .whole__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-4);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .whole__more svg { transition: transform 200ms var(--ease); }
  .whole__more:hover svg { transform: translateX(4px); }
  .whole__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-2);
  }
  .whole__photo {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
  }
  .whole__photo--0 { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  .whole__photo--1, .whole__photo--2 { aspect-ratio: 4 / 3; }
  .whole__photo .media-reveal, .whole__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .whole__photo img { transition: transform 500ms var(--ease); }
  .whole__photo:hover img { transform: scale(1.03); }

  /* nadpis + odkaz v jednom riadku */
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .head-row .section-title { margin-bottom: 0; }
  .head-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .head-row__link:hover { color: var(--ink); }
  .head-row__link svg { transition: transform 200ms var(--ease); }
  .head-row__link:hover svg { transform: translateX(3px); }

  /* prečo i-studio */
  .why { background: var(--surface); border-block: 1px solid var(--line); }
  .why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .why__item {
    padding-top: var(--space-2);
    border-top: 2px solid var(--yellow);
  }
  .why__item h3 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }
  .why__item p { font-size: 0.97rem; color: var(--muted); }

  /* tiles */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    text-decoration: none;
    color: #fff;
    isolation: isolate;
    background: var(--ink);
  }
  .tile__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease), opacity 500ms var(--ease);
    opacity: 0.92;
  }
  .tile:hover img { transform: scale(1.05); opacity: 1; }
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(12 11 8 / 0.85), transparent 55%);
  }
  .tile__label {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tile__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.1;
  }
  .tile__name::after {
    content: '';
    display: block;
    width: 2.2rem;
    height: 3px;
    background: var(--yellow);
    margin-top: 0.5rem;
    transition: width 300ms var(--ease);
  }
  .tile:hover .tile__name::after { width: 3.6rem; }
  .tile__tag {
    font-size: 0.88rem;
    color: color-mix(in srgb, #fff 80%, transparent);
  }

  @media (max-width: 64rem) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .why__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 60rem) {
    .whole__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  }
  @media (max-width: 40rem) {
    .tiles { grid-template-columns: 1fr; }
    .why__list { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  }
</style>

<script>
  // animované počítadlá v čiernom páse — spustia sa, keď pás vojde do viewportu
  document.addEventListener('astro:page-load', () => {
    const strip = document.querySelector('.strip');
    const counters = [...document.querySelectorAll<HTMLElement>('.strip [data-count]')];
    if (!strip || !counters.length || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const start = performance.now();
        const DUR = 1300;
        const tick = (now: number) => {
          const t = Math.min((now - start) / DUR, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          for (const el of counters) {
            const target = Number(el.dataset.count);
            el.textContent = Math.round(target * eased) + (el.dataset.suffix ?? '');
          }
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { threshold: 0.4 }
    );
    io.observe(strip);
  });
</script>
