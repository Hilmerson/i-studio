---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { categories, site } from '../data/site';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { kategoria: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
---

<Base title={`${category.title} — i-studio Stupava`} description={category.metaDescription}>
  <section class="page-head">
    <div class="container">
      <p class="kicker">Sortiment</p>
      <h1 class="page-head__title">{category.title}</h1>
      <p class="page-head__tagline">{category.tagline}</p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container intro">
      <div class="prose">
        {category.intro.map((p) => <p>{p}</p>)}
      </div>
      {
        category.brands && (
          <aside class="brands" aria-label="Značky, s ktorými pracujeme">
            <h2>Pracujeme so značkami</h2>
            <ul>
              {category.brands.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section--tight" aria-labelledby="galeria-title">
    <div class="container">
      <p class="kicker" id="galeria">Naše práce</p>
      <h2 id="galeria-title" class="gallery-title">Realizácie — {category.title.toLowerCase()}</h2>
      <Gallery category={category.slug} title={category.title} />
    </div>
  </section>

  <section class="section--tight">
    <div class="container cta-row">
      <p>Zaujala vás niektorá realizácia? Radi pripravíme podobné riešenie aj pre vás.</p>
      <div class="cta-row__actions">
        <a class="btn btn--primary" href="/kontakt">Nezáväzný dopyt</a>
        <a class="btn btn--ghost" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--space-5);
  }
  .page-head :global(.kicker) { color: color-mix(in srgb, var(--paper) 70%, transparent); }
  .page-head__title {
    font-size: var(--step-4);
    color: #fff;
    line-height: 1;
  }
  .page-head__tagline {
    margin-top: var(--space-2);
    font-size: var(--step-1);
    color: var(--yellow);
    font-family: var(--font-display);
    font-style: italic;
  }
  .intro {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-5);
    align-items: start;
    padding-top: var(--space-5);
  }
  .brands {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius);
    padding: var(--space-3);
  }
  .brands h2 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .brands ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .brands li {
    padding: 0.4rem 0.85rem;
    background: color-mix(in srgb, var(--yellow) 16%, transparent);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .gallery-title {
    font-size: var(--step-3);
    margin-bottom: var(--space-4);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-top: 1px solid var(--line);
    padding-block: var(--space-4);
    font-size: var(--step-1);
    font-family: var(--font-display);
  }
  .cta-row__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  @media (max-width: 60rem) {
    .intro { grid-template-columns: 1fr; gap: var(--space-3); }
  }
</style>
